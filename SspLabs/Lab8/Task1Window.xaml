<Window x:Class="SspLabs.Lab8.Task1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 1 — приоритет триггеров" Height="360" Width="560">
    <Window.Resources>
        <!-- Both triggers set Background. When both are active, the trigger declared LAST wins. -->
        <Style x:Key="FocusLast" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Yellow"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="LightGreen"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HoverLast" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="LightGreen"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Yellow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="10">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
            Каждое поле имеет два триггера: IsMouseOver → жёлтый фон, IsFocused → зелёный фон.
            Щёлкните в поле (фокус) и наведите на него курсор, чтобы оба триггера сработали одновременно.
        </TextBlock>

        <TextBlock Text="1) Последним объявлен IsFocused — при фокусе и наведении фон зелёный:"/>
        <TextBox Style="{StaticResource FocusLast}" Text="Поле 1" Margin="0,2,0,10"/>

        <TextBlock Text="2) Последним объявлен IsMouseOver — при фокусе и наведении фон жёлтый:"/>
        <TextBox Style="{StaticResource HoverLast}" Text="Поле 2" Margin="0,2,0,10"/>

        <TextBlock Text="3) Локальное значение Background=&quot;Pink&quot; — триггеры стиля не действуют:"/>
        <TextBox Style="{StaticResource FocusLast}" Background="Pink" Text="Поле 3" Margin="0,2,0,10"/>

        <TextBlock TextWrapping="Wrap" FontWeight="Bold">
            Правило: из нескольких активных триггеров применяется Setter того, который объявлен позже
            в коллекции Triggers. Локальное значение свойства важнее любых триггеров стиля.
        </TextBlock>
    </StackPanel>
</Window>
