<Window x:Class="SspLabs.Lab7.Task2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 2 и 3 — привязка элементов" Height="470" Width="560">
    <StackPanel Margin="10">
        <TextBlock Text="Задание 2. Исходный код" FontWeight="Bold"/>
        <TextBox x:Name="t1" Margin="0,4"/>
        <TextBox x:Name="t2" Text="{Binding ElementName=t1, Path=Text}" Margin="0,4"/>
        <Slider x:Name="slider1" Margin="0,4"/>
        <Slider x:Name="slider2" Value="{Binding ElementName=slider1, Path=Value}" Margin="0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="DimGray" Margin="0,2,0,10">
            Различие: ввод в t1 сразу виден в t2, а ввод в t2 попадает в t1 только после потери фокуса.
            Для TextBox.Text привязка TwoWay по умолчанию имеет UpdateSourceTrigger=LostFocus.
            Ползунки обновляют друг друга сразу (для Slider.Value — PropertyChanged).
        </TextBlock>

        <TextBlock Text="Задание 2. Исправлено: UpdateSourceTrigger=PropertyChanged" FontWeight="Bold"/>
        <TextBox x:Name="t3" Margin="0,4"/>
        <TextBox Text="{Binding ElementName=t3, Path=Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

        <TextBlock Text="Задание 3. Ползунок ↔ поле ввода ↔ размер шрифта" FontWeight="Bold" Margin="0,14,0,0"/>
        <Slider x:Name="FontSlider" Minimum="8" Maximum="48" Value="14" Margin="0,4"/>
        <TextBox Text="{Binding ElementName=FontSlider, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                 Width="60" HorizontalAlignment="Left" Margin="0,4"/>
        <TextBlock Text="Пример текста" FontSize="{Binding ElementName=FontSlider, Path=Value}" Margin="0,4"/>
    </StackPanel>
</Window>
