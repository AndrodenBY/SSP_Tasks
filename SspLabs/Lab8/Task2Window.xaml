<Window x:Class="SspLabs.Lab8.Task2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 2 — триггеры" Height="420" Width="640">
    <Window.Resources>
        <!-- Text boxes: same gradient background; DataTrigger changes the look by the ComboBox choice. -->
        <Style TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="LightSteelBlue" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=LookBox}" Value="1">
                    <Setter Property="FontFamily" Value="Georgia"/>
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Foreground" Value="DarkRed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=LookBox}" Value="2">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="DarkGreen"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Buttons: custom template so hover/press colors are not hidden by the default chrome. -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Background" Value="Gainsboro"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Gray"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Trigger: hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="LightSkyBlue"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="SteelBlue"/>
                            </Trigger>
                            <!-- MultiTrigger: hover AND pressed -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="SteelBlue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="DarkGray"/>
                                <Setter TargetName="Bd" Property="Background" Value="WhiteSmoke"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="Открыть" Click="Open_Click"/>

            <Button Content="Очистить" Click="Clear_Click">
                <!-- EventTrigger: fade-in of both text boxes after clearing -->
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Box1" Storyboard.TargetProperty="Opacity"
                                                 From="0.1" To="1" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetName="Box2" Storyboard.TargetProperty="Opacity"
                                                 From="0.1" To="1" Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>

            <Button Content="Закрыть" Click="Close_Click">
                <!-- MultiDataTrigger: enabled only when both text boxes are empty -->
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=Box1}" Value=""/>
                                    <Condition Binding="{Binding Text, ElementName=Box2}" Value=""/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="True"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Text="Вид:" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <ComboBox x:Name="LookBox" Width="140" SelectedIndex="0" VerticalAlignment="Center">
                <ComboBoxItem Content="Обычный"/>
                <ComboBoxItem Content="Крупный"/>
                <ComboBoxItem Content="Моноширинный"/>
            </ComboBox>
        </StackPanel>

        <UniformGrid Columns="2">
            <TextBox x:Name="Box1" Text="Текст первого поля"/>
            <TextBox x:Name="Box2" Text="Текст второго поля"/>
        </UniformGrid>
    </DockPanel>
</Window>
