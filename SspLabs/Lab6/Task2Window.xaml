<Window x:Class="SspLabs.Lab6.Task2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="450" Width="700">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <TextBlock Text="Цвет:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="ColorBox" Width="110" SelectedIndex="0" SelectionChanged="Color_Changed">
                <ComboBoxItem Content="Чёрный" Tag="Black"/>
                <ComboBoxItem Content="Красный" Tag="Red"/>
                <ComboBoxItem Content="Зелёный" Tag="Green"/>
                <ComboBoxItem Content="Синий" Tag="Blue"/>
                <ComboBoxItem Content="Оранжевый" Tag="Orange"/>
            </ComboBox>

            <TextBlock Text="Размер:" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <Slider x:Name="SizeSlider" Width="140" Minimum="1" Maximum="40" Value="4"
                    VerticalAlignment="Center" ValueChanged="Size_Changed"/>
            <TextBlock Text="{Binding Value, ElementName=SizeSlider, StringFormat=N0}" Width="24"
                       VerticalAlignment="Center" Margin="4,0"/>

            <!-- Dependent switches: same GroupName -->
            <RadioButton GroupName="Mode" Content="Рисование" Tag="Ink" IsChecked="True"
                         VerticalAlignment="Center" Margin="16,0,6,0" Checked="Mode_Checked"/>
            <RadioButton GroupName="Mode" Content="Редактирование" Tag="Select"
                         VerticalAlignment="Center" Margin="6,0" Checked="Mode_Checked"/>
            <RadioButton GroupName="Mode" Content="Удаление" Tag="EraseByStroke"
                         VerticalAlignment="Center" Margin="6,0" Checked="Mode_Checked"/>
        </StackPanel>

        <Border BorderBrush="Gray" BorderThickness="1" Margin="6,0,6,6">
            <InkCanvas x:Name="Canvas" Background="White"/>
        </Border>
    </DockPanel>
</Window>
