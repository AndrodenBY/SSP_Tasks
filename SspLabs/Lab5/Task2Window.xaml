<Window x:Class="SspLabs.Lab5.Task2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диспетчеры компоновки" Height="330" Width="320">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Two equal Grid columns. Each holds a WrapPanel that rearranges squares when the window is resized.
         Left group is centered vertically, right group sticks to the top. -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <WrapPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="A" Background="Yellow"/>
            <Label Content="B" Background="Red"/>
            <Label Content="C" Background="Green"/>
            <Label Content="D" Background="Blue"/>
            <Label Content="E" Background="Gray"/>
            <Label Content="F" Background="LightGray"/>
        </WrapPanel>

        <WrapPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Label Content="A" Background="Yellow"/>
            <Label Content="B" Background="Red"/>
            <Label Content="C" Background="Green"/>
            <Label Content="D" Background="Blue"/>
            <Label Content="E" Background="Gray"/>
            <Label Content="F" Background="LightGray"/>
        </WrapPanel>
    </Grid>
</Window>
