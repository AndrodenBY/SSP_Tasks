<Window x:Class="SspLabs.Lab5.Task1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Диспетчеры компоновки" Height="230" Width="620">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="65"/>
            <Setter Property="Margin" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>
    </Window.Resources>

    <!-- Grid: left column = recent documents, right column = work area -->
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="2,0,8,0">
            <TextBlock Text="Последние документы" Margin="0,2,0,6"/>
            <TextBlock Text="1.txt" Margin="0,4"/>
            <TextBlock Text="2.txt" Margin="0,4"/>
            <TextBlock Text="3.txt" Margin="0,4"/>
            <TextBlock Text="4.txt" Margin="0,4"/>
            <TextBlock Text="5.txt" Margin="0,4"/>
            <TextBlock Text="6.txt" Margin="0,4"/>
        </StackPanel>

        <!-- DockPanel: two rows docked on top, the WrapPanel fills the rest (LastChildFill) -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="Открыть"/>
                <Button Content="Сохранить"/>
                <Button Content="Закрыть"/>
                <Button Content="Обработать"/>
                <Button Content="О программе"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,10,0,0">
                <TextBlock Text="1.txt" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Text="2.txt" Margin="0,0,8,0"/>
                <TextBlock Text="3.txt"/>
            </StackPanel>
            <WrapPanel>
                <Label Content="A" Background="Yellow"/>
                <Label Content="B" Background="Red"/>
                <Label Content="C" Background="Green"/>
                <Label Content="D" Background="Blue"/>
                <Label Content="E" Background="Gray"/>
                <Label Content="F" Background="#EEEECC"/>
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
